generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum TodoStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  coins     Int      @default(0)
  note      String?
  avatar    String?  // URL or path to avatar image
  lists     List[]
  notes     Note[]
  checkIns  CheckIn[]
  todos     Todo[]
  tags      Tag[]
  financeLedger FinanceLedger?
  financeEntries FinanceEntry[]
  financeBatches FinanceBatch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String   // HTML content from Tiptap
  tagIds    String[] @default([])
  noteDate  String?  // Calendar date: YYYY-MM-DD, independent of updatedAt
  startAt   DateTime?
  endAt     DateTime?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckIn {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  date      String   // Format: YYYY-MM-DD
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model List {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  ownerId   String   @db.ObjectId
  owner     User     @relation(fields: [ownerId], references: [id])
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  weight    Int      @default(1)
  listId    String   @db.ObjectId
  list      List     @relation(fields: [listId], references: [id])
}

model Todo {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String?
  status            TodoStatus     @default(NOT_STARTED)
  priority          TodoPriority   @default(MEDIUM)
  recurrence        RecurrenceType @default(NONE)
  recurrenceInterval Int           @default(1)
  recurrenceEndAt   DateTime?
  tagIds            String[]       @default([])
  startAt           DateTime       @default(now())
  endAt             DateTime
  userId            String         @db.ObjectId
  user              User           @relation(fields: [userId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Tag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  color     String   @default("#E98A7A")
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// Website records are a working copy; Excel remains the authoritative ledger.
model FinanceLedger {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model FinanceEntry {
  id               String   @id @default(uuid()) @map("_id")
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id])
  kind             String
  data             Json
  revision         Int      @default(1)
  exportedRevision Int      @default(0)
  syncedRevision   Int      @default(0)
  syncError        String?
  sourceRefs       Json?
  changeId         String   @default(uuid())
  masterRevision   Int?
  masterHash       String?
  recordedDate     String?
  serverShadow     Json?
  deleted          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
}

model FinanceBatch {
  id          String   @id @default(uuid()) @map("_id")
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  payload     Json
  // Per-record receipts support partial returns and safe repeated imports.
  receipts    Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
